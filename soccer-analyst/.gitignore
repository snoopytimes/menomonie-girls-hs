# ─── Data ────────────────────────────────────────────────────────────────────
# Keep directories in version control, but ignore their contents.
data/videos/*
!data/videos/.gitkeep

# ─── Output ──────────────────────────────────────────────────────────────────
output/reports/*
!output/reports/.gitkeep

# ─── sn-gamestate (git submodule) ────────────────────────────────────────────
# Tracked as a submodule → fork at github.com:snoopytimes/sn-gamestate
# Upstream: https://github.com/SoccerNet/sn-gamestate
# Submodule contents are never staged in this repo; only the commit pointer is.

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/

# Catch-all for model weight files that might land outside pretrained_models/
*.pt
*.pth
*.pth.tar

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/

